# Servidor
PORT=3000

# Banco de dados - PostgreSQL.
# No Railway, use a variavel de referencia ${{Postgres.DATABASE_URL}} (rede interna).
# Para rodar local apontando pro mesmo banco, use a DATABASE_PUBLIC_URL do Railway.
DATABASE_URL="postgresql://usuario:senha@host:5432/railway"

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Evolution API
EVOLUTION_API_URL=https://sua-evolution.up.railway.app
EVOLUTION_API_KEY=sua-chave-da-evolution
EVOLUTION_INSTANCE=gabinete

# WhatsApp
# JID do grupo dos assessores (termina em @g.us). Descubra com: npm run grupos
GRUPO_ASSESSORES_JID=000000000000000000@g.us
# Numero de quem consulta o sistema (vereador), so digitos com DDI+DDD
VEREADOR_NUMERO=5513999998888
VEREADOR_NOME=Marcio
# Numero do chip do bot (Dipo) conectado na Evolution, so digitos com DDI+DDD.
# Usado para detectar quando o bot e mencionado (@numero) no grupo dos assessores.
BOT_NUMERO=5513999997777

# Opcional: protege a rota /webhook (?token=... ou header x-webhook-token)
WEBHOOK_TOKEN=
