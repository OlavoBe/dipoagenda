# Servidor
PORT=3000

# Banco de dados - PostgreSQL dedicado ao Dipo (nao compartilhar com a
# Evolution API: ela mantem dezenas de conexoes ociosas e esgota o limite).
# No Railway, use a referencia do servico, ex.: ${{Postgres.DATABASE_URL}}
# e acrescente ?connection_limit=5 para o pool do Prisma ficar previsivel.
DATABASE_URL="postgresql://usuario:senha@host:5432/railway?connection_limit=5"

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Evolution API
EVOLUTION_API_URL=https://sua-evolution.up.railway.app
EVOLUTION_API_KEY=sua-chave-da-evolution
EVOLUTION_INSTANCE=gabinete

# WhatsApp
# JID do grupo dos assessores (termina em @g.us). Descubra com: npm run grupos
GRUPO_ASSESSORES_JID=000000000000000000@g.us
# Numero de quem consulta o sistema (vereador), so digitos com DDI+DDD
VEREADOR_NUMERO=5513999998888
VEREADOR_NOME=Marcio
# Numero do chip do bot (Dipo) conectado na Evolution, so digitos com DDI+DDD.
# Usado para detectar quando o bot e mencionado (@numero) no grupo dos assessores.
BOT_NUMERO=5513999997777
# Quem acompanha o sistema: consulta no privado e recebe os mesmos informes
# automaticos do vereador (lembrete de 1h e bom-dia das 07h). Serve para
# conferir o que chega nele e testar o que sobe. Separe por virgula; vazio desliga.
ADMIN_NUMEROS=

# Opcional: protege a rota /webhook (?token=... ou header x-webhook-token)
WEBHOOK_TOKEN=
