# Servidor
PORT=3000

# Banco de dados (SQLite local; trocar por PostgreSQL/Neon no futuro)
DATABASE_URL="file:./dev.db"

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Evolution API
EVOLUTION_API_URL=https://sua-evolution.up.railway.app
EVOLUTION_API_KEY=sua-chave-da-evolution
EVOLUTION_INSTANCE=gabinete

# WhatsApp
# JID do grupo dos assessores (termina em @g.us)
GRUPO_ASSESSORES_JID=000000000000000000@g.us
# Numero do vereador, so digitos com DDI+DDD (ex.: 5513999998888)
VEREADOR_NUMERO=5513999998888
VEREADOR_NOME=Marcio

# Opcional: protege a rota /webhook (?token=... ou header x-webhook-token)
WEBHOOK_TOKEN=
