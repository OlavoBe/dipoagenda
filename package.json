{
  "name": "gabinete-guaruja",
  "version": "0.1.0",
  "description": "Sistema de gestao de gabinete legislativo via WhatsApp + IA - Camara Municipal de Guaruja/SP",
  "main": "src/server.js",
  "scripts": {
    "start": "prisma migrate deploy && node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "conectar": "node scripts/conectar.js",
    "grupos": "node scripts/grupos.js",
    "webhook": "node scripts/webhook.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "openai": "^6.44.0"
  },
  "devDependencies": {
    "prisma": "^6.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
